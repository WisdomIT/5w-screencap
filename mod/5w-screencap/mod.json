{
  "id": "5w-screencap",
  "name": "5W Screencap",
  "version": "0.1.0",
  "hmgapi": ">=1.0.0",
  "authors": [
    "WisdomIT"
  ],
  "description": "Saves the head unit screen to USB: a photo with one button press, a video while you drive. CarPlay and Android Auto included; picture only, no sound.",
  "repo": "https://github.com/WisdomIT/5w-screencap",
  "live": true,
  "apps": [
    {
      "apk": "app/Screencap.apk",
      "package": "dev.wisdomit.screencap"
    }
  ],
  "services": [
    {
      "name": "screencapd",
      "jar": "svc/screencapd.jar",
      "class": "dev.wisdomit.screencap.daemon.Main",
      "user": "root",
      "start": "android",
      "restart": true
    }
  ],
  "usb": [
    "5W-Screencap"
  ],
  "provides": {
    "launcher": [
      {
        "package": "dev.wisdomit.screencap",
        "class": ".MainActivity",
        "title": "화면 캡처",
        "icon": "icon.png",
        "icon_night": "icon_night.png",
        "icon_disabled": "icon_disabled.png",
        "icon_disabled_night": "icon_disabled_night.png"
      }
    ],
    "star_key": [
      {
        "id": "capture",
        "title": "화면 캡처",
        "broadcast": "dev.wisdomit.screencap.CAPTURE"
      },
      {
        "id": "record",
        "title": "화면 녹화 시작/정지",
        "broadcast": "dev.wisdomit.screencap.RECORD"
      }
    ]
  },
  "car_events": {
    "shutdown": {}
  },
  "input": [
    {
      "key": "wheel_custom",
      "press": "hold",
      "when": "settings.capture=wheel_custom.hold",
      "broadcast": "dev.wisdomit.screencap.CAPTURE"
    },
    {
      "key": "custom",
      "press": "hold",
      "when": "settings.capture=custom.hold",
      "broadcast": "dev.wisdomit.screencap.CAPTURE"
    },
    {
      "key": "mode",
      "press": "short",
      "when": "settings.capture=mode.short",
      "broadcast": "dev.wisdomit.screencap.CAPTURE"
    },
    {
      "key": "mode",
      "press": "short",
      "stock": "replace",
      "when": "settings.capture=mode.short_r",
      "broadcast": "dev.wisdomit.screencap.CAPTURE"
    },
    {
      "key": "mode",
      "press": "hold",
      "when": "settings.capture=mode.hold",
      "broadcast": "dev.wisdomit.screencap.CAPTURE"
    },
    {
      "key": "mode",
      "press": "short",
      "stock": "replace",
      "when": "settings.capture=mode.double",
      "broadcast": "dev.wisdomit.screencap.CAPTURE"
    },
    {
      "key": "mute",
      "press": "short",
